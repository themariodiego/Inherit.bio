{
  "name": "inherit-prepared-worker",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "containers": [
    {
      "class_name": "PreparationWorker",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PREPARATION_WORKER",
        "class_name": "PreparationWorker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PreparationWorker"]
    }
  ],
  "vars": {
    "INHERIT_PREPARED_WGS_ENABLED": "true",
    "NEXT_PUBLIC_SUPABASE_URL": "https://zuvloczwgrayonqabnss.supabase.co",
    "INHERIT_PREPARED_R2_ORIGIN": "https://inherit-prepared-artifacts.mariodiego-dev.workers.dev",
    "INHERIT_PREPARED_R2_BUCKET": "inherit-prepared-production"
  },
  "env": {
    "preview": {
      "name": "inherit-prepared-worker-preview",
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "containers": [
        {
          "class_name": "PreparationWorker",
          "image": "./Dockerfile",
          "image_build_context": "../..",
          "instance_type": "standard-1",
          "max_instances": 1
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "PREPARATION_WORKER",
            "class_name": "PreparationWorker"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["PreparationWorker"]
        }
      ],
      "vars": {
        "INHERIT_PREPARED_WGS_ENABLED": "true",
        "NEXT_PUBLIC_SUPABASE_URL": "",
        "INHERIT_PREPARED_R2_ORIGIN": "https://inherit-prepared-artifacts-preview.mariodiego-dev.workers.dev",
        "INHERIT_PREPARED_R2_BUCKET": "inherit-prepared-preview"
      }
    }
  }
}
