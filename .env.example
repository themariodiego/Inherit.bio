# Sequence environment — copy to .env.local and fill in.
# See docs/self-hosting.md for how to obtain each value.

# --- Supabase (required) ---
# Project URL and anon (publishable) key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Service-role (secret) key — server only, never exposed to the browser.
# Used by: research-library pipeline, account deletion, privileged jobs.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Direct Postgres connection string (migrations, worker). Dashboard → Database → Connection string.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# --- Resend (required for email: verification, report-ready, research digest) ---
RESEND_API_KEY=re_YOUR_KEY
# Verified sender. Resend test mode: use onboarding@resend.dev and your own inbox.
EMAIL_FROM="Sequence <onboarding@resend.dev>"

# --- App ---
# Canonical public URL of this deployment (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32-byte base64 key for encrypting user-supplied LLM API keys at rest (BYOK).
# Generate: openssl rand -base64 32
BYOK_ENCRYPTION_KEY=GENERATE-ME

# --- Optional: LLM copilot local-endpoint policy ---
# Set to "true" ONLY when self-hosting so the copilot may reach a local model
# (localhost/RFC-1918). Left unset on shared/hosted deployments, the server
# refuses private/loopback provider URLs (SSRF protection); cloud-metadata
# and link-local addresses are always refused.
# ALLOW_PRIVATE_LLM_ENDPOINTS=true

# --- Optional: scheduled-job auth ---
# Random bearer token the operator/scheduler presents to /api/jobs/* endpoints.
# Generate: openssl rand -hex 32
JOBS_SECRET=GENERATE-ME
# Vercel Cron presents this to the scheduled jobs (research-refresh,
# annotation-refresh). Set it in Vercel so the crons authenticate.
# Generate: openssl rand -hex 32
CRON_SECRET=GENERATE-ME

# NOTE — deliberately absent:
# * No analytics keys, no tracker IDs: Sequence ships zero third-party trackers.
# * No cloud LLM keys: LLM keys are BYOK, entered by each user in Settings and
#   stored encrypted; they are never deployment-level configuration.
