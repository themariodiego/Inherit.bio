# Inherit environment — copy to .env.local and fill in.
# See docs/self-hosting.md for how to obtain each value.

# --- Supabase (required) ---
# Project URL and anon (publishable) key: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Service-role (secret) key — server only, never exposed to the browser.
# Used by: research-library pipeline, account deletion, privileged jobs.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Dedicated server-only ES256 private JWK for the upload-only JWT signer.
# Provisioning and Storage acceptance must be verified before enabling the new transport.
# Never use a NEXT_PUBLIC_ name or reuse the BYOK key. See docs/own-upload-consent.md.
INHERIT_UPLOAD_SIGNING_JWK=
# Server-only issuance stop: only exact true pauses new canonical upload leases.
# Issued uploads and existing file controls continue. Separate from INHERIT_PAUSE_LEGACY_UPLOADS.
INHERIT_CANONICAL_UPLOADS_PAUSED=false
# Private prepared-object path: both this flag and database admission must be enabled.
# Keep disabled until the complete deployment and lifecycle evidence is accepted.
INHERIT_PREPARED_WGS_ENABLED=false
# HTTPS origin of the signed R2 artifact gateway; no path or trailing slash.
INHERIT_PREPARED_R2_ORIGIN=
# Exact private bucket bound to that gateway and selected in database config.
INHERIT_PREPARED_R2_BUCKET=
# Direct Postgres connection string (migrations, worker). Dashboard → Database → Connection string.
# Opt-in atomic completion; use the project's IPv4 shared pooler on Vercel.
INHERIT_NORMALIZATION_DIRECT_DATABASE=false
# If required by the provider, set INHERIT_NORMALIZATION_DATABASE_CA_CERT to
# its trusted public PEM CA certificate. Never disable TLS verification.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
# That optional trust anchor: the provider's own public PEM CA certificate,
# BEGIN/END lines and real newlines included, under 16384 characters. Read only
# when the direct connection is a hosted one. A malformed or non-CA value fails
# the connection; it never relaxes TLS verification and is never a peer key.
# INHERIT_NORMALIZATION_DATABASE_CA_CERT=

# --- Resend (required for email: verification, report-ready, research digest) ---
RESEND_API_KEY=re_YOUR_KEY
RESEND_WEBHOOK_SECRET=whsec_YOUR_SECRET
# Verified sender. Resend test mode: use onboarding@resend.dev and your own inbox.
EMAIL_FROM="Inherit <onboarding@resend.dev>"

# --- App ---
# Canonical public URL of this deployment (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Origin used to build the links inside outbound mail: invitations, rights and
# withdrawal links, and the cancel/export links in an account-deletion notice.
# SET THIS. Unlike NEXT_PUBLIC_SITE_URL, which falls back to localhost and so
# fails visibly, this falls back to the hosted deployment at
# https://www.inherit.bio — so leaving it unset sends your users' mail links,
# and the rights tokens they carry, to someone else's site.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32-byte base64 key for encrypting user-supplied LLM API keys at rest (BYOK).
# Generate: openssl rand -base64 32
BYOK_ENCRYPTION_KEY=GENERATE-ME

# --- Optional: LLM copilot local-endpoint policy ---
# Set to "true" ONLY when self-hosting so the copilot may reach a local model
# (localhost/RFC-1918). Left unset on shared/hosted deployments, the server
# refuses private/loopback provider URLs (SSRF protection); cloud-metadata
# and link-local addresses are always refused.
# ALLOW_PRIVATE_LLM_ENDPOINTS=true

# --- Optional: own-copilot local model transport (self-hosting only) ---
# A separate, stricter mechanism from ALLOW_PRIVATE_LLM_ENDPOINTS above, for
# the own-copilot path: it permits a model served on this same host. All four
# must be set together, and none of them takes effect on a Vercel runtime
# (VERCEL or VERCEL_ENV present). See docs/own-copilot-authority.md.
# Must be exactly self-hosted-development; any other value leaves local off.
# INHERIT_DEPLOYMENT_KIND=self-hosted-development
# Must be exactly 1.
# ALLOW_LOCAL_MODEL_ENDPOINTS=1
# Your attestation that a same-host, egress-isolated network already exists.
# The string below is the only accepted value; it records your claim and
# neither builds nor verifies the isolation.
# INHERIT_LOCAL_MODEL_HOST_ATTESTATION=same-host-egress-isolated-v1
# JSON array of at most 16 exact permitted origins — scheme, host and port
# only, no path, no trailing slash. Anything else leaves local transport off.
# INHERIT_LOCAL_MODEL_ORIGINS=["http://127.0.0.1:11434"]

# --- Optional: self-hosted upload size caps ---
# Per-tier upload ceilings in bytes for the self-host upload surfaces
# (src/lib/limits.ts); the own-upload path reads its ceilings from the database
# instead. Unset, empty or not a positive number falls back to the demo caps
# shown here. Keep each at or below the max object size your storage provider
# actually enforces.
# NEXT_PUBLIC_MAX_ARRAY_BYTES=104857600
# NEXT_PUBLIC_MAX_VCF_BYTES=209715200
# NEXT_PUBLIC_MAX_BAM_BYTES=5368709120

# --- Optional: scheduled-job auth ---
# Random bearer token the operator/scheduler presents to /api/jobs/* endpoints.
# Generate: openssl rand -hex 32
JOBS_SECRET=GENERATE-ME
# Vercel Cron presents this to the scheduled jobs (research-refresh,
# annotation-refresh). Set it in Vercel so the crons authenticate.
# Generate: openssl rand -hex 32
CRON_SECRET=GENERATE-ME

# NOTE — deliberately absent:
# * Variables the runtime, the platform or the test harness sets rather than
#   you: NODE_ENV, CI, the Vercel markers, and the two local-test flags. Each
#   one is listed with its reason in RUNTIME_INJECTED in scripts/env-gate.ts,
#   which fails if this file ever starts declaring one of them.
# * No analytics keys, no tracker IDs: Inherit ships zero third-party trackers.
# * No cloud LLM keys: LLM keys are BYOK, entered by each user in Settings and
#   stored encrypted; they are never deployment-level configuration.
