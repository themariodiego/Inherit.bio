+-- 1. The own Copilot context: a self subject as before, or an adult record
+-- the account holds as its own.
+create function private.own_copilot_context_v1(p_account_id uuid,p_session_id uuid,p_subject_id uuid) returns jsonb
+language plpgsql security definer set search_path=pg_catalog,private as $function$
+declare v_class text; c jsonb; s public.subjects%rowtype; p public.subject_principals%rowtype;
+begin
