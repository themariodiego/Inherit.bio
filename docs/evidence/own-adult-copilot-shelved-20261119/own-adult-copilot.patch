+import { createHash } from "node:crypto";
+import { readFileSync, readdirSync } from "node:fs";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+
+/**
+ * G8.5, Copilot for an adult's own record (20261119100000_own_adult_copilot.sql;
+ * owner decision of 19 November 2026). The migration patches three bodies in
+ * place under the md5-guarded convention: the exact reviewed predecessor and
+ * ACL, one anchor per patch, the reviewed successor and the unchanged ACL,
+ * 55000 on any mismatch. pg_get_functiondef keeps a body verbatim, so each
+ * predecessor's definition is rebuilt here from the migration that last
+ * defined it and every md5 of the chain is recomputed from source. The pgTAP
+ * suite (supabase/tests/own_adult_copilot.sql) runs the migration against the
+ * real chain and holds the database to the same final successors.
+ */
+
+const root = path.resolve(__dirname, "..");
+const read = (file: string) => readFileSync(path.join(root, file), "utf8");
+const md5 = (text: string) => createHash("md5").update(text, "utf8").digest("hex");
+const count = (text: string, fragment: string) => text.split(fragment).length - 1;
+
+const NAME = "20261119100000_own_adult_copilot.sql";
+const migration = read(`supabase/migrations/${NAME}`);
+const pgtap = read("supabase/tests/own_adult_copilot.sql");
+
+/** The text between two markers, the first occurrence after `after`. */
+function between(text: string, start: string, end: string, after = 0): string {
+  const from = text.indexOf(start, after);
+  expect(from, start).toBeGreaterThanOrEqual(0);
+  const to = text.indexOf(end, from + start.length);
+  expect(to, end).toBeGreaterThan(from);
+  return text.slice(from + start.length, to);
+}
+
+/** A predecessor as pg_get_functiondef prints it: its normalized header around the verbatim body. */
+const predecessors: Record<string, () => string> = {
+  "private.own_copilot_configuration_v1(uuid,uuid,uuid)": () => {
+    const source = read("supabase/migrations/20260907081757_canonical_own_copilot_authority.sql");
+    const start = source.lastIndexOf("create function private.own_copilot_configuration_v1(");
+    const body = between(source, "as $function$", "$function$;", start);
+    return "CREATE OR REPLACE FUNCTION private.own_copilot_configuration_v1(p_account_id uuid, p_session_id uuid, p_subject_id uuid)\n"
+      + " RETURNS jsonb\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'private'\nAS $function$"
+      + body + "$function$\n";
+  },
+  "private.own_report_purge_scope_v1(uuid)": () => {
+    const source = read("supabase/migrations/20260907111757_canonical_own_ancestry_generation.sql");
+    const start = source.lastIndexOf("create or replace function private.own_report_purge_scope_v1(");
+    const body = between(source, "as $fn$", "$fn$;", start);
+    return "CREATE OR REPLACE FUNCTION private.own_report_purge_scope_v1(p_grant uuid)\n"
+      + " RETURNS jsonb\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog'\nAS $function$"
+      + body + "$function$\n";
+  },
+  "private.purge_path_a_subject_v1(uuid,uuid)": () => {
+    const source = read("supabase/migrations/20261016181000_subject_delete.sql");
+    const start = source.lastIndexOf("create function private.purge_path_a_subject_v1(");
+    const body = between(source, "as $$", "$$;", start);
+    return "CREATE OR REPLACE FUNCTION private.purge_path_a_subject_v1(p_subject_id uuid, p_account_id uuid)\n"
+      + " RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO ''\nAS $function$"
+      + body + "$function$\n";
+  },
+};
+
+interface Patch { ordinal: number; target: string; before: string; after: string; acl: string; old: string; next: string; label: string }
+const patches: Patch[] = [...migration.matchAll(
+  /\((\d+),'([^']+)','([0-9a-f]{32})',\s*'([0-9a-f]{32})','([^']+)',\s*\$old\$([\s\S]*?)\$old\$,\s*\$new\$([\s\S]*?)\$new\$,\s*'([^']+)'\)/g,
+)].map(match => ({ ordinal: Number(match[1]), target: match[2]!, before: match[3]!, after: match[4]!, acl: match[5]!,
+  old: match[6]!, next: match[7]!, label: match[8]! }));
+
+/** Every target's successor, step by step, as the patch loop computes it. */
+function successors(): Record<string, string> {
+  const definitions = Object.fromEntries(Object.entries(predecessors).map(([target, build]) => [target, build()]));
+  for (const patch of patches) definitions[patch.target] = definitions[patch.target]!.replace(patch.old, () => patch.next);
+  return definitions;
+}
+
+describe("the release it belongs to", () => {
+  it("is a guarded production release, the only one of its day, after every migration it patches", () => {
+    expect(migration.startsWith("-- =====================================================================\n"
+      + "-- PRODUCTION RELEASE: GUARDED.")).toBe(true);
+    const files = readdirSync(path.join(root, "supabase/migrations")).filter(file => file.endsWith(".sql")).sort();
+    expect(files.filter(file => file.startsWith("20261119"))).toEqual([NAME]);
+    expect(files.at(-1)).toBe(NAME);
+    for (const earlier of ["20260907081757_canonical_own_copilot_authority.sql", "20260907111757_canonical_own_ancestry_generation.sql",
+      "20261016181000_subject_delete.sql", "20261025400000_path_a_account_accept_typed_name.sql"]) expect(NAME > earlier).toBe(true);
+  });
+});
+
+describe("the guarded in-place patches", () => {
+  it("rebuild each predecessor from source at exactly the digest the patch and the preflight pin", () => {
+    const preflight = between(migration, "do $predecessor$", "$predecessor$;");
+    expect(patches.map(patch => patch.ordinal)).toEqual([1, 2, 3, 4]);
+    for (const [target, build] of Object.entries(predecessors)) {
+      const first = patches.find(patch => patch.target === target)!;
+      expect(md5(build()), target).toBe(first.before);
+      expect(preflight).toContain(`to_regprocedure('${target}')\n   and md5(pg_get_functiondef(p.oid))='${first.before}'\n`
+        + `   and p.proacl::text='${first.acl}'`);
+    }
+    expect(Object.fromEntries(patches.map(patch => [patch.ordinal, patch.acl]))).toEqual({
+      1: "{postgres=X/postgres,service_role=X/postgres}", 2: "{postgres=X/postgres}", 3: "{postgres=X/postgres}", 4: "{postgres=X/postgres}" });
+    expect(preflight).toContain("raise exception using errcode='55000',message='own adult copilot prerequisite differs'");
+  });
+
+  it("finds each anchor exactly once at its step, and each successor is the reviewed md5 the next step and the postflight require", () => {
+    const definitions = Object.fromEntries(Object.entries(predecessors).map(([target, build]) => [target, build()]));
+    const last: Record<string, string> = {};
+    for (const patch of patches) {
+      const definition = definitions[patch.target]!;
+      expect(count(definition, patch.old), patch.label).toBe(1);
+      expect(md5(definition), patch.label).toBe(patch.before);
+      definitions[patch.target] = definition.replace(patch.old, () => patch.next);
+      expect(md5(definitions[patch.target]!), patch.label).toBe(patch.after);
+      last[patch.target] = patch.after;
+    }
+    expect(patches[3]!.before).toBe(patches[2]!.after);
+    const postflight = between(migration, "do $postflight$", "$postflight$;");
+    for (const [target, after] of Object.entries(last)) {
+      expect(postflight).toContain(`('${target}','${after}',`);
+      // The pgTAP suite holds the database to the same final successor.
+      expect(pgtap).toContain(`('${target}','${after} `);
+    }
+  });
+
+  it("routes the configuration through the own Copilot context and changes nothing else in it", () => {
+    const target = "private.own_copilot_configuration_v1(uuid,uuid,uuid)";
+    const before = predecessors[target]!(), after = successors()[target]!;
+    expect(after).toContain(" c:=private.own_copilot_context_v1(p_account_id,p_session_id,p_subject_id);");
+    expect(after).not.toContain("own_report_context_v1(");
+    const call = " c:=private.own_copilot_context_v1(p_account_id,p_session_id,p_subject_id);";
+    expect(after.slice(after.indexOf(call) + call.length))
+      .toBe(before.slice(before.indexOf(" c:=public.own_report_context_v1(p_account_id,p_session_id,p_subject_id);")
+        + " c:=public.own_report_context_v1(p_account_id,p_session_id,p_subject_id);".length));
+  });
+
+  it("widens the purge scope only for a Copilot grant on an adult record no account owns", () => {
+    const target = "private.own_report_purge_scope_v1(uuid)";
+    const before = predecessors[target]!(), after = successors()[target]!;
+    expect(after).toContain("and (s.subject_class='self'\n");
+    expect(after).toContain("  or (s.subject_class='other_adult' and s.owner_account_id is null and g.purpose in('copilot.local','copilot.cloud')))\n");
+    // Every other condition of the scope is the predecessor's, byte for byte.
+    const tail = " and s.subject_account_id=d.recipient_account_id";
+    expect(after.slice(after.indexOf(tail))).toBe(before.slice(before.indexOf(tail)));
+  });
+
+  it("deletes the record's conversations before its grants end, and leaves the rest of Path A's delete as it was", () => {
+    const target = "private.purge_path_a_subject_v1(uuid,uuid)";
+    const before = predecessors[target]!(), after = successors()[target]!;
+    const chats = after.indexOf("delete from public.chats where id=any(v_chats);");
+    const messages = after.indexOf("delete from public.chat_messages where chat_id=any(v_chats);");
+    const residual = after.indexOf("message='subject_delete_chat_residual'");
+    const grants = after.indexOf(" v_grants:=array(select g.grant_id");
+    expect(after.indexOf(" v_chats:=array(select c.id from public.chats c where c.subject_id=s.id order by c.id);")).toBeGreaterThan(0);
+    expect(messages).toBeLessThan(chats);
+    expect(chats).toBeLessThan(residual);
+    expect(residual).toBeLessThan(grants);
+    expect(after.slice(grants)).toBe(before.slice(before.indexOf(" v_grants:=array(select g.grant_id")));
+    // The guard that opens the body (a record holding a file is still refused) is unchanged.
+    const guard = before.slice(before.indexOf(" select * into s"), before.indexOf(" v_grants:=array("));
+    expect(after).toContain(guard);
+    // The same model working state, in the same order, as the self record's delete.
+    const self = read("supabase/migrations/20261016181000_subject_delete.sql");
+    const selfBlock = between(self, " v_chats:=array(select c.id from public.chats c where c.subject_id=s.id order by c.id);",
+      " n_chats:=cardinality(v_chats);");
+    const ours = between(after, " v_chats:=array(select c.id from public.chats c where c.subject_id=s.id order by c.id);",
+      " if exists(select 1 from public.chat_messages m where m.retrieved_subject_ids && array[s.id])");
+    expect(ours).toBe(selfBlock);
+  });
+
+  it("uses the convention's guard body", () => {
+    const guard = between(migration, "order by ordinal loop\n", "\n end loop;");
+    const reference = read("supabase/migrations/20261024110000_copilot_settings_delete_nonce.sql");
+    expect(between(reference, "order by ordinal loop\n", "\n end loop;")).toBe(guard);
+    const tested = between(pgtap, "declare definition text;before_acl aclitem[];\nbegin\n", "\nend $guarded$;");
+    expect(tested).toBe(guard);
+  });
+});
+
+describe("the own Copilot context", () => {
+  const context = between(migration, "create function private.own_copilot_context_v1(", "\n$function$;");
+
+  it("returns exactly the self context for a self subject, before any other check", () => {
+    const self = context.indexOf("if v_class='self' then return public.own_report_context_v1(p_account_id,p_session_id,p_subject_id); end if;");
+    expect(self).toBeGreaterThan(0);
+    for (const later of ["lock_invitation_transitions_v1", "own_upload_store_authority_v1", "public_appeal_target_held_v1"]) {
+      expect(context.indexOf(later), later).toBeGreaterThan(self);
+    }
+    expect(context).toContain("if v_class is distinct from 'other_adult' or p_account_id is null then\n"
+      + "  raise exception using errcode='42501',message='not_found'; end if;");
+  });
+
+  it("decides the own adult record from database columns only, in the self context's lock order", () => {
+    const lock = context.indexOf("perform private.lock_invitation_transitions_v1();");
+    const store = context.indexOf("c:=private.own_upload_store_authority_v1(p_account_id,p_session_id,p_subject_id);");
+    const shape = context.indexOf("select * into s from public.subjects where id=p_subject_id for share;");
+    expect(lock).toBeGreaterThan(0);
+    expect(lock).toBeLessThan(store);
+    expect(store).toBeLessThan(shape);
+    for (const exact of [
+      "if s.subject_class is distinct from 'other_adult' or s.subject_account_id is distinct from p_account_id\n"
+        + "  or s.owner_account_id is not null or s.ownership_transferred_at is not null\n"
+        + "  or s.lifecycle is distinct from 'active' or s.analysis_stopped_at is not null or s.cohort_id is not null then",
+      "if private.public_appeal_target_held_v1('subject',s.id) then",
+      "b.status='current' and b.binding_kind='adult_claim'",
+      "and b.binding_revision=(c->>'accountBindingRevision')::bigint and sp.status='active'",
+      "and sp.account_id=p_account_id and sp.subject_id=s.id and sp.principal_kind='account_subject' for share of b,sp;",
+      "and i.invitation_kind='adult_subject' and i.status='accepted';",
+      "and cs.signer_principal_id=p.id and cs.purpose='adult-subject-account-acceptance'",
+      "and ca.artifact_key='consent.subject-adult' and ca.superseded_at is null",
+      "where sc.subject_id=s.id and sc.account_id=p_account_id and sc.consent_type='adult_source'\n"
+        + "  and sc.revoked_at is null",
+      "return c||jsonb_build_object('principalId',p.id,'principalRevision',p.principal_revision);",
+    ]) expect(context).toContain(exact);
+    // No request field: every argument is the server's account, session and subject.
+    expect(context).not.toMatch(/current_setting|p_snapshot|p_payload/);
+  });
+
+  it("is owner-only, and the postflight holds it to that ACL", () => {
+    expect(migration).toContain("revoke all on function private.own_copilot_context_v1(uuid,uuid,uuid)\n"
+      + " from public,anon,authenticated,inherit_upload_only,service_role;");
+    expect(migration).not.toMatch(/grant [^;]* to (anon|authenticated|public|service_role)\b/i);
+    expect(between(migration, "do $postflight$", "$postflight$;"))
+      .toContain("(select proacl::text from pg_proc where oid='private.own_copilot_context_v1(uuid,uuid,uuid)'::regprocedure)\n"
+        + "   is distinct from '{postgres=X/postgres}'");
+  });
+
+  it("pins each callee to the one reviewed body production holds", () => {
+    const preflight = between(migration, "do $predecessor$", "$predecessor$;");
+    for (const [signature, body] of [
+      ["public.own_report_context_v1(uuid,uuid,uuid)", "5bb0a10ee76fd3eaceacbcedbcb40003"],
+      ["private.own_upload_store_authority_v1(uuid,uuid,uuid)", "8c4c704f4b23546b063a0c85744b1735"],
+      ["private.public_appeal_target_held_v1(text,uuid)", "7402cafec700ba4c1f30e9e016140742"],
+      ["private.lock_invitation_transitions_v1()", "3a28aeaf4bf736cbba89e3b209649557"],
+    ]) expect(preflight).toContain(`('${signature}','${body}')`);
+    expect(preflight).toContain("as x(signature,body) on p.oid=to_regprocedure(x.signature) and md5(pg_get_functiondef(p.oid))=x.body)<>4");
+  });
+});
