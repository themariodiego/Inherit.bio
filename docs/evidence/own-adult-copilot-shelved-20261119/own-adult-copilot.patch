+ 'fce304d610384353411e770e2b11bc59','978078aaef9b559cf19cd39c2afeb40d','{postgres=X/postgres,service_role=X/postgres}',
+ ' c:=public.own_report_context_v1(p_account_id,p_session_id,p_subject_id);',
+ ' c:=private.own_copilot_context_v1(p_account_id,p_session_id,p_subject_id);',
+ 'own copilot configuration context')::pg_temp.patch_item)$$,'55000','own copilot configuration context predecessor differs',
+ 'the migration cannot be applied twice');
