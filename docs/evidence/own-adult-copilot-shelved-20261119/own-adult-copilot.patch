+ c:=private.own_upload_store_authority_v1(p_account_id,p_session_id,p_subject_id);
+ -- Held by the person themselves: accepted into this account, owned by none.
+ select * into s from public.subjects where id=p_subject_id for share;
+ if s.subject_class is distinct from 'other_adult' or s.subject_account_id is distinct from p_account_id
+  or s.owner_account_id is not null or s.ownership_transferred_at is not null
+  or s.lifecycle is distinct from 'active' or s.analysis_stopped_at is not null or s.cohort_id is not null then
+  raise exception using errcode='42501',message='not_found'; end if;
+ -- A public appeal holding the record denies every read.
+ if private.public_appeal_target_held_v1('subject',s.id) then
+  raise exception using errcode='42501',message='not_found'; end if;
+ -- The adult_claim binding only the account acceptance writes, at the
+ -- revision the store authority read, and the record's own principal.
+ select sp.* into p from public.subject_account_bindings b join public.subject_principals sp on sp.id=b.subject_principal_id
+ where b.subject_id=s.id and b.account_id=p_account_id and b.status='current' and b.binding_kind='adult_claim'
+  and b.binding_revision=(c->>'accountBindingRevision')::bigint and sp.status='active'
+  and sp.account_id=p_account_id and sp.subject_id=s.id and sp.principal_kind='account_subject' for share of b,sp;
+ if p.id is null then raise exception using errcode='42501',message='not_found'; end if;
