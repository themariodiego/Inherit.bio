+ l,pg_temp.r2())),'R2 '||l||' is refused') from unnest(array['restricted','revoked','purge_queued','purged']) l;
+select ok(pg_temp.refused_after(format($s$update public.subject_account_bindings set status='revoked',ended_at=clock_timestamp()
