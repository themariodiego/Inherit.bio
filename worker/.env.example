# Sequence Tier-3 worker — copy to .env and fill in.
# The worker connects directly to Postgres and to Supabase Storage; it uses
# the SERVICE ROLE key (server-side only). Never expose these values.

# Direct Postgres connection string (Supabase dashboard → Database → Connection string).
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Supabase project URL and service-role key (dashboard → Project Settings → API).
# NOTE: this is SUPABASE_URL (not NEXT_PUBLIC_SUPABASE_URL) — the worker is not
# a browser app.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Optional: queue poll interval in milliseconds (default 5000).
WORKER_POLL_MS=5000
